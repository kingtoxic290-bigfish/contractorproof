# PostgreSQL
DATABASE_URL=postgresql://contractorproof:contractorproof@localhost:5433/contractorproof

# API
PORT=4000
# Production requires a unique secret of at least 32 characters. Do not use this example value.
JWT_SECRET=replace-with-a-long-random-secret
# Local-only: allow a missing JWT_SECRET. Never set this in production.
ALLOW_INSECURE_JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# First ADMIN seed (prisma db seed). Never commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# Local evidence storage (MinIO can replace this later via StorageService)
STORAGE_PATH=./storage

# Local Ethereum-compatible network (Hardhat)
RPC_URL=http://127.0.0.1:8545
# Leave empty to use Hardhat's default local accounts. Never commit a real key.
# Production requires both CONTRACT_ADDRESS and BLOCKCHAIN_PRIVATE_KEY.
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
CHAIN_ID=
BLOCKCHAIN_CONFIRMATIONS=1
