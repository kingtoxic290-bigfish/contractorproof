generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CONTRACTOR
  CLIENT
  CONSULTANT_ENGINEER
  PROCUREMENT_OFFICER
  AUDITOR
  ADMIN
}

enum EvidenceStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum AttestationDecision {
  APPROVED
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum CorrectionStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum VariationStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum BlockchainEventType {
  PROJECT_REGISTERED
  VERIFICATION
  ATTESTATION
  CORRECTION
  DISPUTE
  RESOLUTION
  VARIATION
}

/// Fingerprint compare result. Not a workflow status and not EvidenceStatus.
enum VerificationStatus {
  MATCH
  MISMATCH
  PENDING
  UNAVAILABLE
}

enum VerificationSource {
  INTERNAL
  PUBLIC
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contractor              Contractor?
  ownedProjects           Project[]              @relation("ProjectClient")
  uploadedEvidence        Evidence[]             @relation("EvidenceUploader")
  createdEvidenceVersions EvidenceVersion[]      @relation("EvidenceVersionCreator")
  attestations            Attestation[]
  disputes                Dispute[]
  corrections             Correction[]
  variations              ContractVariation[]
  auditLogs               AuditLog[]
  blockchainEvents        BlockchainEvent[]      @relation("BlockchainEventActor")
  verifications           Verification[]
  disputeResolutions      DisputeResolution[]    @relation("DisputeResolutionActor")
  correctionResolutions   CorrectionResolution[] @relation("CorrectionResolutionActor")
  variationResolutions    VariationResolution[]  @relation("VariationResolutionActor")
  variationReviews        ContractVariation[]    @relation("VariationReviewer")
  crbVerificationRequests CrbVerification[]      @relation("CrbVerificationRequester")
  procurementLinksCreated ProcurementLink[] @relation("ProcurementLinkActor")
}

model Contractor {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  legalName             String
  crbRegistrationNumber String?
  crbCategory           String?
  crbType               String?
  crbClass              String?
  crbStatus             String?
  crbLastVerifiedAt     DateTime?
  /// Source of the latest CRB check. Null until a check has actually been
  /// performed; a source is never asserted speculatively.
  crbSource             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  projects Project[]

  /// Append-only regulatory checks. History is never overwritten.
  crbVerifications CrbVerification[]
  procurementLinks ProcurementLink[]

  @@index([crbRegistrationNumber])
}

/// Factual outcome of one CRB registration check. These are states of the
/// external source, not judgements about the contractor.
enum CrbVerificationStatus {
  REGISTERED
  NOT_REGISTERED
  EXPIRED
  SUSPENDED
  PENDING
  UNAVAILABLE
  INVALID_REFERENCE
}

/// Which CRB adapter produced a check.
enum CrbVerificationSource {
  /// Deterministic local adapter for development and demonstration.
  SANDBOX
  /// Official CRB connector. Requires authorized CRB integration access.
  CRB_OFFICIAL
}

model CrbVerification {
  id                    String                @id @default(uuid())
  contractorId          String
  contractor            Contractor            @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  /// Reference sent to CRB for this check, as supplied by the ContractorProof record.
  registrationReference String
  status                CrbVerificationStatus
  source                CrbVerificationSource
  /// Registration number exactly as CRB returned it, when returned.
  registrationNumber    String?
  registeredName        String?
  category              String?
  registrationClass     String?
  registrationDate      DateTime?
  expiryDate            DateTime?
  /// Opaque reference issued by CRB for this response, when supplied.
  externalReference     String?
  /// When the check was performed against the external source.
  checkedAt             DateTime              @default(now())
  /// SHA-256 over the canonical normalized record. Proves record integrity and
  /// makes any later alteration detectable. The raw external response is never
  /// stored, and never written to the blockchain.
  canonicalDigest       String
  /// Stable machine-readable failure code when status is UNAVAILABLE.
  failureCode           String?
  requestedById         String?
  requestedBy           User?                 @relation("CrbVerificationRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt             DateTime              @default(now())

  @@index([contractorId, checkedAt])
  @@index([contractorId, status])
  @@index([requestedById])
}

enum ProcurementSourceSystem {
  SANDBOX_DEMO
  NEST_OCDS_PUBLIC
}

model ProcurementRecord {
  id                String                 @id @default(uuid())
  sourceSystem      ProcurementSourceSystem
  externalReference String
  sourceRecordId    String?
  sourceUrl         String
  createdAt         DateTime               @default(now())

  observations ProcurementObservation[]
  links        ProcurementLink[]

  @@unique([sourceSystem, externalReference])
  @@index([sourceRecordId])
}

model ProcurementObservation {
  id                   String           @id @default(uuid())
  procurementRecordId  String
  procurementRecord    ProcurementRecord @relation(fields: [procurementRecordId], references: [id], onDelete: Restrict)
  ocid                 String
  releaseId            String
  releaseDate          DateTime?
  tenderReference      String?
  title                String?
  description          String?
  buyerName            String?
  buyerIdentifier      String?
  procurementCategory  String?
  tenderStatus         String?
  awardStatus          String?
  awardDate            DateTime?
  contractReference    String?
  contractStatus       String?
  contractorName       String?
  contractorIdentifier String?
  contractValue        Decimal?         @db.Decimal(20, 4)
  contractCurrency     String?
  contractStartDate    DateTime?
  contractEndDate      DateTime?
  normalizedData       Json
  sourceDigest         String
  retrievedAt          DateTime         @default(now())

  @@index([procurementRecordId, retrievedAt])
  @@index([ocid, releaseId])
}

model ProcurementLink {
  id                 String           @id @default(uuid())
  contractorId       String
  contractor         Contractor       @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  procurementRecordId String
  procurementRecord  ProcurementRecord @relation(fields: [procurementRecordId], references: [id], onDelete: Restrict)
  linkedById         String
  linkedBy           User             @relation("ProcurementLinkActor", fields: [linkedById], references: [id], onDelete: Restrict)
  linkedAt           DateTime         @default(now())

  @@unique([contractorId, procurementRecordId])
  @@index([procurementRecordId])
}

model Project {
  id                    String     @id @default(uuid())
  clientId              String?
  client                User?      @relation("ProjectClient", fields: [clientId], references: [id], onDelete: Restrict)
  contractorId          String
  contractor            Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  name                  String
  description           String?
  nestTenderReference   String?
  nestContractReference String?
  ocid                  String?
  procuringEntity       String?
  contractStatus        String?
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  nestSource            String     @default("SYNTHETIC_DEMO")
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  milestones           Milestone[]
  verificationPolicies VerificationPolicy[]
  variations           ContractVariation[]
  blockchainEvents     BlockchainEvent[]

  @@index([contractorId])
  @@index([clientId])
  @@index([nestContractReference])
  @@index([ocid])
}

model VerificationPolicy {
  id                String   @id @default(uuid())
  projectId         String?
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name              String
  requiredApprovals Int      @default(1)
  allowedRoles      Role[]
  /// Display aliases such as SITE_INSPECTOR -> CONSULTANT_ENGINEER. Not extra login roles.
  verifierLabels    Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  milestones Milestone[]

  @@index([projectId])
}

model Milestone {
  id          String              @id @default(uuid())
  projectId   String
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  policyId    String?
  policy      VerificationPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  name        String
  description String?
  status      MilestoneStatus     @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  evidence     Evidence[]
  attestations Attestation[]
  disputes     Dispute[]
  corrections  Correction[]
  variations   ContractVariation[]

  @@index([projectId])
  @@index([policyId])
}

model Evidence {
  id               String           @id @default(uuid())
  milestoneId      String
  milestone        Milestone        @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  uploadedById     String
  uploadedBy       User             @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  /// Denormalized current version file name. Authority is EvidenceVersion.fileName.
  fileName         String
  /// Denormalized current version storage key. Authority is EvidenceVersion.storageReference.
  storageKey       String
  /// Denormalized current version MIME type. Authority is EvidenceVersion.mimeType.
  mimeType         String
  /// Denormalized current version size. Authority is EvidenceVersion.sizeBytes.
  sizeBytes        Int
  /// Denormalized current version SHA-256. Authority is EvidenceVersion.sha256.
  sha256           String
  status           EvidenceStatus   @default(PENDING_VERIFICATION)
  currentVersionId String?          @unique
  currentVersion   EvidenceVersion? @relation("EvidenceCurrentVersion", fields: [currentVersionId, id], references: [id, evidenceId], onDelete: Restrict)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  versions     EvidenceVersion[]   @relation("EvidenceVersions")
  attestations Attestation[]
  corrections  Correction[]
  variations   ContractVariation[]
  disputes     Dispute[]

  /// Uniqueness of the *current* hash on a milestone. Historical hashes live on EvidenceVersion.
  @@unique([milestoneId, sha256])
  @@unique([currentVersionId, id])
  @@index([sha256])
  @@index([uploadedById])
}

/// Immutable stored file + SHA-256. Do not update sha256 or storageReference after insert.
model EvidenceVersion {
  id               String    @id @default(uuid())
  evidenceId       String
  evidence         Evidence  @relation("EvidenceVersions", fields: [evidenceId], references: [id], onDelete: Restrict)
  currentFor       Evidence? @relation("EvidenceCurrentVersion")
  versionNumber    Int
  storageReference String
  fileName         String
  mimeType         String
  sizeBytes        Int
  /// Canonical application SHA-256: lowercase hex, 64 characters.
  sha256           String
  createdById      String?
  createdBy        User?     @relation("EvidenceVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())

  verifications         Verification[]
  correctionsAsOriginal Correction[]           @relation("CorrectionOriginalVersion")
  correctionResolutions CorrectionResolution[] @relation("CorrectionCorrectedVersion")

  @@unique([id, evidenceId])
  @@unique([evidenceId, versionNumber])
  @@unique([evidenceId, sha256])
  @@index([evidenceId])
  @@index([sha256])
  @@index([createdById])
}

/// Append-only fingerprint compare. Not EvidenceStatus and not Attestation.
model Verification {
  id                  String             @id @default(uuid())
  evidenceVersionId   String
  evidenceVersion     EvidenceVersion    @relation(fields: [evidenceVersionId], references: [id], onDelete: Restrict)
  status              VerificationStatus
  presentedSha256     String?
  authoritativeSha256 String
  source              VerificationSource
  requestedById       String?
  requestedBy         User?              @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())

  @@index([evidenceVersionId])
  @@index([status])
  @@index([createdAt])
  @@index([requestedById])
}

model Attestation {
  id           String              @id @default(uuid())
  milestoneId  String
  milestone    Milestone           @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  evidenceId   String
  evidence     Evidence            @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  verifierId   String
  verifier     User                @relation(fields: [verifierId], references: [id], onDelete: Restrict)
  verifierRole Role
  decision     AttestationDecision
  comment      String?
  createdAt    DateTime            @default(now())

  @@unique([evidenceId, verifierId])
  @@index([milestoneId])
  @@index([verifierId])
}

model BlockchainEvent {
  id              String              @id @default(uuid())
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  eventType       BlockchainEventType
  /// Deterministic idempotency key: `${eventType}:${projectId}:${referenceId|projectId}`.
  /// Confirmed proof is implied by non-null txHash (ADR-0002); no separate status column.
  logicalKey      String              @unique
  referenceId     String?
  previousEventId String?
  previousEvent   BlockchainEvent?    @relation("EventChain", fields: [previousEventId], references: [id], onDelete: Restrict)
  nextEvents      BlockchainEvent[]   @relation("EventChain")
  txHash          String?
  blockNumber     Int?
  evidenceHash    String?
  actorId         String?
  actor           User?               @relation("BlockchainEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  recordedAt      DateTime            @default(now())
  createdAt       DateTime            @default(now())

  disputesAsOriginal   Dispute[]           @relation("DisputeOriginalEvent")
  disputesAsResolution Dispute[]           @relation("DisputeResolutionEvent")
  disputesAsProof      Dispute[]           @relation("DisputeProofEvent")
  correctionsAsProof   Correction[]        @relation("CorrectionProofEvent")
  corrections          Correction[]
  variationsAsPrevious ContractVariation[] @relation("VariationPreviousEvent")
  variationsAsProof    ContractVariation[] @relation("VariationProofEvent")

  @@index([projectId])
  @@index([eventType])
  @@index([previousEventId])
  @@index([txHash])
}

model Dispute {
  id                String              @id @default(uuid())
  milestoneId       String
  milestone         Milestone           @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  evidenceId        String?
  evidence          Evidence?           @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  raisedById        String
  raisedBy          User                @relation(fields: [raisedById], references: [id], onDelete: Restrict)
  status            DisputeStatus       @default(OPEN)
  reason            String
  disputeEventId    String?             @unique
  disputeEvent      BlockchainEvent?    @relation("DisputeProofEvent", fields: [disputeEventId], references: [id], onDelete: Restrict)
  originalEventId   String?
  originalEvent     BlockchainEvent?    @relation("DisputeOriginalEvent", fields: [originalEventId], references: [id], onDelete: Restrict)
  resolutionEventId String?
  resolutionEvent   BlockchainEvent?    @relation("DisputeResolutionEvent", fields: [resolutionEventId], references: [id], onDelete: Restrict)
  resolutions       DisputeResolution[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([milestoneId])
  @@index([raisedById])
  @@index([status])
  @@index([evidenceId])
}

model DisputeResolution {
  id           String        @id @default(uuid())
  disputeId    String        @unique
  dispute      Dispute       @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  status       DisputeStatus
  resolution   String
  resolvedById String
  resolvedBy   User          @relation("DisputeResolutionActor", fields: [resolvedById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())

  @@index([resolvedById])
  @@index([createdAt])
}

model Correction {
  id                        String                 @id @default(uuid())
  milestoneId               String
  milestone                 Milestone              @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  originalEventId           String
  originalEvent             BlockchainEvent        @relation(fields: [originalEventId], references: [id], onDelete: Restrict)
  originalEvidenceVersionId String?
  originalEvidenceVersion   EvidenceVersion?       @relation("CorrectionOriginalVersion", fields: [originalEvidenceVersionId], references: [id], onDelete: Restrict)
  reason                    String
  evidenceId                String?
  evidence                  Evidence?              @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  actorId                   String
  actor                     User                   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  status                    CorrectionStatus       @default(OPEN)
  correctionEventId         String?                @unique
  correctionEvent           BlockchainEvent?       @relation("CorrectionProofEvent", fields: [correctionEventId], references: [id], onDelete: Restrict)
  resolutions               CorrectionResolution[]
  createdAt                 DateTime               @default(now())

  @@index([milestoneId])
  @@index([originalEventId])
  @@index([actorId])
  @@index([originalEvidenceVersionId])
  @@index([status])
}

model CorrectionResolution {
  id                         String           @id @default(uuid())
  correctionId               String           @unique
  correction                 Correction       @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  status                     CorrectionStatus
  resolution                 String
  correctedEvidenceVersionId String?
  correctedEvidenceVersion   EvidenceVersion? @relation("CorrectionCorrectedVersion", fields: [correctedEvidenceVersionId], references: [id], onDelete: Restrict)
  resolvedById               String
  resolvedBy                 User             @relation("CorrectionResolutionActor", fields: [resolvedById], references: [id], onDelete: Restrict)
  createdAt                  DateTime         @default(now())

  @@index([correctedEvidenceVersionId])
  @@index([resolvedById])
  @@index([createdAt])
}

model ContractVariation {
  id                 String                @id @default(uuid())
  projectId          String
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  previousEventId    String
  previousEvent      BlockchainEvent       @relation("VariationPreviousEvent", fields: [previousEventId], references: [id], onDelete: Restrict)
  variationReference String
  reason             String
  evidenceId         String?
  evidence           Evidence?             @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  actorId            String
  actor              User                  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reviewedById       String?
  reviewedBy         User?                 @relation("VariationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  status             VariationStatus       @default(OPEN)
  milestoneId        String?
  milestone          Milestone?            @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  originalState      Json
  proposedState      Json
  variationEventId   String?               @unique
  variationEvent     BlockchainEvent?      @relation("VariationProofEvent", fields: [variationEventId], references: [id], onDelete: Restrict)
  resolutions        VariationResolution[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([projectId, variationReference])
  @@index([projectId])
  @@index([previousEventId])
  @@index([actorId])
  @@index([milestoneId])
  @@index([status])
  @@index([reviewedById])
}

model VariationResolution {
  id           String            @id @default(uuid())
  variationId  String            @unique
  variation    ContractVariation @relation(fields: [variationId], references: [id], onDelete: Restrict)
  status       VariationStatus
  decision     String
  note         String
  resolvedById String
  resolvedBy   User              @relation("VariationResolutionActor", fields: [resolvedById], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())

  @@index([resolvedById])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
